{
  "name": "justwrite-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "JustWrite's Node server — Fastify on the family kit, run by the desktop app in a utilityProcess, headless as `justwrite-server serve`, or `npm run server` in a checkout. Its own package because the packaged app installs only what src-electron/package.json names (app-structure §Q.3); it also holds the editor schema the renderer and the sync share.",
  "license": "MIT",
  "exports": {
    "./serve": "./src/serve.js",
    "./editor/*": "./src/editor/*"
  },
  "dependencies": {
    "@delebash/llm-runner": "file:../../just-llm-runner/server",
    "@delebash/sqlite-sync": "file:../../just-sqlite-sync",
    "@fastify/static": "^10.1.5",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-character-count": "^3.27.1",
    "@tiptap/extension-focus": "^3.27.1",
    "@tiptap/extension-highlight": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-mention": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-subscript": "^3.27.1",
    "@tiptap/extension-superscript": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-task-item": "^3.27.1",
    "@tiptap/extension-task-list": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-typography": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/html": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/y-tiptap": "^3.0.9",
    "happy-dom": "^20.14.5",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  }
}
