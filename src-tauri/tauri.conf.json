{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JustWrite",
  "version": "1.0.0",
  "identifier": "com.justwrite.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite"
  },
  "app": {
    "windows": [
      {
        "title": "JustWrite",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#fafaf7",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A focused novel-writing app.",
    "longDescription": "JustWrite is a novel-writing app pairing a distraction-free TipTap rich-text editor with planning tools — outline, characters, locations, worldbuilding — and manuscript export to PDF, DOCX, and EPUB."
  }
}
