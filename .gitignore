# Bench harness output. Raw captures + timings stay local; the CONCLUSIONS get
# written into the relevant docs/plans/* doc, which is what ships.

# Audit tool output (jscpd report dir, biome scratch dumps)
report/
biome_output.json
biome_parsed.json

# Python bytecode
__pycache__/
*.pyc
server/build/

# Python virtualenv (local, never committed)
.venv/

# just-ai-help — the translation tool's working state.
# Its folder holds two kinds of file. config.json and *.accepted.json / *.notes.json are
# DECISIONS and knowledge: committed, because --check-only runs in CI against a fresh clone and
# a gitignored verdict would be missing exactly where the gate reads it. Everything below is
# machine state — regenerable, and *.db holds API keys, which the tool refuses to store unless
# git genuinely ignores the file.
just-ai-help/*.probe.json
just-ai-help/.jah-cache.json
just-ai-help/.jah-probe-cache.json
just-ai-help/.jah.db

# App data (the family portable default: a data/ folder beside the app —
# llm_runner.platform.data_paths). Never committed.
data/
server/data/
