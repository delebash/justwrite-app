node_modules/
out/
dist/
.DS_Store
*.log
.vscode/
.idea/

# Bench harness output. Raw captures + timings stay local; the CONCLUSIONS get
# written into the relevant docs/plans/* doc, which is what ships.

# Audit tool output (jscpd report dir, biome scratch dumps)
report/
biome_output.json
biome_parsed.json

# docgen (just-ai-i18n-docgen) — the translation tool's working state, the lines its Setup page
# prints (its server/src/init.js gitignoreLines). Its folder holds two kinds of file.
# config.json and *.accepted.json / *.notes.json are DECISIONS and knowledge: committed, because
# `check` runs in CI against a fresh clone and a gitignored verdict would be missing exactly where
# the gate reads it. Everything below is machine state — regenerable. (Until 2026-10-15 this block
# named the tool's old folder, just-ai-help.)
just-ai-i18n-docgen/*.probe.json
just-ai-i18n-docgen/.just-ai-i18n-docgen-cache.json
just-ai-i18n-docgen/.just-ai-i18n-docgen-probe-cache.json
just-ai-i18n-docgen/.just-ai-i18n-docgen-state.json

# App data (the family portable default: a data/ folder beside the app —
# the kit's platform/data_paths.js). Never committed.
data/
server/data/
# The 2026-08-15 headless root, put aside when the dev root moved here (2026-10-08).
data-old-*/

# The Electron + Vite era's installer output (electron-builder → release/); older checkouts still hold it
release/

# Quasar's generated files and its build output (dist/spa, dist/electron, dist/capacitor)
.quasar/
/quasar.config.*.temporary.compiled*

# The phone app: Capacitor's web copy, its packages, and the native projects it generates
# (quasar build -m capacitor -T android re-creates them)
/src-capacitor/www
/src-capacitor/node_modules

# the phone's in-app server, built by scripts/phone-worker.js
/src/phone/worker-bundle/

# npm run eval output (scripts/eval.js): per-run replies and reports — their findings go to TASKS/RESEARCH
/evals/results/

# npm run test:flows output (Playwright Test): its report and failure traces
/tests/flows/report/
/tests/flows/artifacts/

# Claude Code's per-machine settings (never committed)
/.claude/settings.local.json
