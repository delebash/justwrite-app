{
  "name": "justwrite",
  "version": "2.1.0",
  "description": "JustWrite — a writing app for novels, with AI assistance from any OpenAI-compatible provider.",
  "homepage": "https://delebash.github.io/justwrite-website/",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev -m electron",
    "dev:spa": "quasar dev",
    "build": "quasar build -m electron",
    "build:spa": "quasar build",
    "build:unpacked": "quasar build -m electron --skip-pkg",
    "build:android": "quasar build -m capacitor -T android",
    "postinstall": "quasar prepare --silent",
    "server": "node scripts/node24.js server/src/serve.js serve",
    "test:server": "node scripts/node24.js node_modules/vitest/vitest.mjs run --config server/vitest.config.js",
    "test:unit": "vitest run",
    "test:fast": "npm run test:unit && npm run build:spa && npm run test:server && npm run i18n:docs",
    "test": "npm test --prefix e2e",
    "screenshots": "node e2e/capture-direct.js",
    "smoke": "node scripts/smoke.js",
    "eval": "node scripts/eval.js",
    "test:flows": "quasar build && playwright test",
    "lint": "biome check .",
    "bump": "node scripts/bump.js",
    "release": "node scripts/release.js",
    "release:windows": "npm run release -- --platform windows",
    "release:macos": "npm run release -- --platform macos",
    "release:linux": "npm run release -- --platform linux",
    "i18n:lint": "eslint -c eslint.i18n.config.js \"src/**/*.{js,vue}\"",
    "i18n:report": "vue-i18n-extract report --vueFiles \"src/**/*.?(js|vue)\" --languageFiles \"{src/i18n/locales,../just-core/packages/ui/src/i18n/locales}/en.json\" --exclude kit.",
    "i18n:pseudo": "node scripts/i18n-pseudo.js",
    "bench": "node bench/harness/run.js",
    "bench:gpu": "npm run bench -- --config bench/harness/configs/gpu.json --autostart",
    "bench:cpu": "npm run bench -- --config bench/harness/configs/cpu.json --autostart",
    "dup": "jscpd",
    "i18n:docs": "node ../just_ai_i18n_docgen/scripts/node24.js ../just_ai_i18n_docgen/server/src/cli.js extract just-ai-i18n-docgen/config.json --check"
  },
  "dependencies": {
    "@delebash/core": "file:../just-core/packages/core",
    "@quasar/extras": "^2.1.0",
    "@stdlib/datasets-stopwords-en": "^0.2.3",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-mention": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/suggestion": "^3.33.0",
    "dompurify": "^3.4.17",
    "front-matter": "^4.0.2",
    "github-slugger": "^2.0.0",
    "image-size": "^2.1.0",
    "nltk-stopwords": "^1.0.3",
    "qrcode": "^1.5.4",
    "quasar": "^2.35.2",
    "simple-statistics": "^8.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@eslint/compat": "^2.1.1",
    "@floating-ui/dom": "^1.8.0",
    "@internationalized/number": "^3.6.9",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@playwright/test": "1.65.0",
    "@quasar/app-vite": "^3.10.3",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@tiptap/vue-3": "^3.33.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "autoprefixer": "^10.6.2",
    "depcheck": "^1.4.7",
    "docx": "^9.15.3",
    "dom-accessibility-api": "^0.7.1",
    "esbuild": "^0.28.2",
    "esbuild-plugins-node-modules-polyfill": "^1.8.3",
    "eslint": "^10.14.0",
    "eslint-plugin-i18next": "^6.1.5",
    "jscpd": "^5.4.2",
    "jsdom": "^31.0.0",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.15",
    "madge": "^8.0.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "pdfmake": "^0.3.13",
    "pinia": "^4.1.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "pseudo-localization": "^3.1.3",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-i18n": "^11.4.18",
    "vue-i18n-extract": "^2.0.7",
    "vue-router": "^5.4.0"
  },
  "allowScripts": {
    "electron": true,
    "koffi": true,
    "better-sqlite3": true,
    "esbuild": true,
    "@parcel/watcher": true
  },
  "workspaces": [
    "server"
  ],
  "productName": "JustWrite",
  "overrides": {
    "happy-dom": "^21.0.4"
  }
}
