{
  "name": "justwrite",
  "version": "1.0.0",
  "description": "JustWrite — a writing app for novels, with AI assistance from any OpenAI-compatible provider.",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "build:vite": "vite build",
    "preview:vite": "vite preview",
    "dev": "node scripts/dev.js",
    "server": "node scripts/node24.js server/src/serve.js serve",
    "build": "vite build && electron-builder",
    "bump": "node scripts/bump.js",
    "release": "node scripts/release.js",
    "release:windows": "npm run release -- --platform windows",
    "release:macos": "npm run release -- --platform macos",
    "release:linux": "npm run release -- --platform linux",
    "screenshots": "node e2e/capture-direct.js",
    "test": "npm test --prefix e2e",
    "smoke": "node scripts/smoke.js",
    "test:unit": "vitest run",
    "test:server": "node scripts/node24.js node_modules/vitest/vitest.mjs run --config server/vitest.config.js",
    "test:fast": "npm run test:unit && npm run build:vite && npm run test:server",
    "i18n:lint": "eslint -c eslint.i18n.config.js \"src/**/*.vue\"",
    "i18n:report": "vue-i18n-extract report --vueFiles \"src/**/*.?(js|vue)\" --languageFiles \"src/i18n/locales/*.json\"",
    "i18n:pseudo": "node scripts/i18n-pseudo.js",
    "bench": "node bench/harness/run.js",
    "bench:gpu": "npm run bench -- --config bench/harness/configs/gpu.json --autostart",
    "bench:cpu": "npm run bench -- --config bench/harness/configs/cpu.json --autostart",
    "dup": "jscpd",
    "lint": "biome check ."
  },
  "dependencies": {
    "@delebash/llm-runner": "file:../just-llm-runner/server",
    "@delebash/sqlite-sync": "file:../just-sqlite-sync",
    "@fastify/static": "^10.1.5",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-character-count": "^3.27.1",
    "@tiptap/extension-focus": "^3.27.1",
    "@tiptap/extension-highlight": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-mention": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-subscript": "^3.27.1",
    "@tiptap/extension-superscript": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-task-item": "^3.27.1",
    "@tiptap/extension-task-list": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-typography": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/html": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/suggestion": "^3.27.1",
    "@tiptap/y-tiptap": "^3.0.9",
    "happy-dom": "^20.14.5",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@floating-ui/dom": "^1.7.6",
    "@fontsource/albert-sans": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@fontsource/spline-sans": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@tanstack/vue-table": "^8.21.3",
    "@tiptap/vue-3": "^3.27.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vueuse/core": "^14.3.0",
    "depcheck": "^1.4.7",
    "docx": "^9.7.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "jscpd": "^5.0.11",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "madge": "^8.0.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "pdfmake": "^0.3.11",
    "pinia": "^3.0.4",
    "playwright": "^1.61.0",
    "pseudo-localization": "^3.1.2",
    "reka-ui": "^2.10.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vue": "^3.5.38",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.4.6",
    "vue-i18n-extract": "^2.0.7",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9"
  },
  "allowScripts": {
    "electron": true,
    "koffi": true,
    "better-sqlite3": true
  },
  "build": {
    "appId": "com.justwrite.app",
    "productName": "JustWrite",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "electron/**",
      "server/src/**",
      "src/services/editorSchema.js",
      "src/services/aiDiff.js",
      "src/services/markers.js",
      "src/services/searchReplace.js",
      "dist/**",
      "samples/**",
      "package.json",
      "!**/node_modules/better-sqlite3/{deps,src,build/Release/obj,build/Release/obj.target,build/deps}/**",
      "!**/node_modules/better-sqlite3/build/Release/*.{pdb,iobj,ipdb,lib,exp}"
    ],
    "asarUnpack": [
      "**/*.node",
      "samples/**"
    ],
    "extraResources": [
      {
        "from": "build/launcher",
        "to": ".."
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "justwrite"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "node_modules/@delebash/llm-runner/src/shell/installer.nsh"
    },
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
